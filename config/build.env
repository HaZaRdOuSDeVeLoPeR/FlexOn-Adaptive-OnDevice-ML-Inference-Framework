# FlexOn dependency versions

# ONNX Runtime release
ORT_VERSION="v1.20.0"

# ONNX protobuf/model library
ONNX_VERSION="v1.16.1"

# yaml-cpp release
YAML_CPP_VERSION="0.8.0"

# NVIDIA cuDNN package version
CUDNN_VERSION="9.27.0.42-1"

# Maximum concurrent ORT compilation jobs.
# Keep this conservative because CUDA compilation is memory intensive.
ORT_BUILD_JOBS="2"

# ORT/Eigen dependency correction.
#
# ORT v1.20.0 references an Eigen archive whose currently served
# GitLab archive has a different SHA1.
ORT_EIGEN_SHA1_OLD="be8be39fdbc6e60e94fa7870b280707069b5b81a"
ORT_EIGEN_SHA1_NEW="32b145f525a8308d7ab1c09388b2e288312d8eba"